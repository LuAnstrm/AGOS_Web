{
  "name": "agos-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic AGOS sensor-node packets posted to the backend's POST /readings",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/run.ts",
    "demo": "node src/run.ts --interval 2 --ticks 60",
    "once": "node src/run.ts --ticks 60 --no-loop",
    "once": "node src/index.ts --ticks 1",
    "test": "node --test test/*.test.ts",
    "listen": "node src/listen.ts",
    "storm": "node src/index.ts --profile storm --interval 0.25 --ticks 140 --quiet",
    "sos": "node src/sos.ts"
  }
}
