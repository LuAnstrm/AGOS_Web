PORT=3000
DATABASE_URL=postgres://agos:agos@localhost:5433/agos
DB_SYNC=true

# Auth. Required in production (NODE_ENV=production): the server won't start
# without them. In development, built-in dev values are used with a warning.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# Shared key for sensor/mesh gateways and the simulator (X-Device-Key header).
DEVICE_API_KEY=
# Origins allowed to call the API with the officer session cookie.
WEB_ORIGINS=http://localhost:3001

# Optional, local dev: test officer used by the latency listener
# (create the account with npm run create-officer).
# AGOS_OFFICER_EMAIL=
# AGOS_OFFICER_PASSWORD=
